        "provisional_hours",
        "provisional_weight",
        "final_hours",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "ignore_before_hours": {
          "type": "number",
          "minimum": 0
        },
        "provisional_hours": {
          "type": "number",
          "minimum": 0
        },
        "provisional_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "final_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "best_early_metric": {
          "type": "string"
        },
        "how_to_verify": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "seed",
            "research",
            "numa"
          ]
        },
        "added": {
          "$ref": "#/$defs/date"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "judging": {
      "type": "object",
      "description": "Judging windows per post type (R7). A post is ignored before ignore_before_hours and before its first pull at or after provisional_hours; a pull at or after provisional_hours counts at provisional_weight; a pull at or after final_hours (or the store's last pull, 7d, when final_hours is later) counts in full and replaces the provisional entry, never both. Story windows are under 24 h (Instagram keeps Story insights 24 h only).",
      "propertyNames": {
        "$ref": "#/$defs/post_type"
      },
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "ignore_before_hours",
          "provisional_hours",
          "provisional_weight",
          "final_hours",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "ignore_before_hours": {
            "type": "number",
            "minimum": 0
          },
          "provisional_hours": {
            "type": "number",
            "minimum": 0
          },
          "provisional_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "final_hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "best_early_metric": {
            "type": "string"
          },
          "how_to_verify": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "seed",
              "research",
              "numa"
            ]
          },
          "added": {
            "$ref": "#/$defs/date"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "exceptions": {
            "type": "object",
            "description": "Metric-specific windows (e.g. saves final at 7 d): at an earlier read that metric is left out of the score.",
            "propertyNames": {
              "$ref": "#/$defs/metric"
            },
            "additionalProperties": {
              "$ref": "#/$defs/window"
            }
          }
        }
      }
    }
  }
