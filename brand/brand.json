  "claims": {
    "_readme": "The claims policy as data. claims_scan.py, validate_plan.py and the Critic use it on ALL text: voiceover, on-screen text, captions, hashtags and pinned comments. Patterns are Python regular expressions matched case-insensitively. Before scanning, phrases in 'allow_exact' and matches of 'allow_patterns' are removed (the safety line names 'blood pressure' on purpose; 'treat yourself' and 'a treat' are not medical). Each banned entry has a severity: 'fail' (a banned claim: exit 1, Critic hard gate) or 'warn' (ambiguous or outcome language: a WARN line for review). This policy is general information from research, not legal advice; an advertising lawyer reviews it once before launch.",
    "source": "spec p.20-22",
    "principle": "Sell the experience, never the outcome.",
    "banned": [
      {
        "id": "inflammation",
        "label": "inflammation",
        "severity": "fail",
        "patterns": [
          "\\binflamm\\w*"
        ],
        "applies_to": "all"
      },
      {
        "id": "immunity",
        "label": "immunity or immune",
        "severity": "fail",
        "patterns": [
          "\\bimmun(e|ity|ities)"
        ],
        "applies_to": "all"
      },
      {
        "id": "detox",
        "label": "detox or toxins",
        "severity": "fail",
        "patterns": [
          "\\bdetox\\w*",
          "\\btoxin(s)?\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "fat_weight",
        "label": "burns fat, calories or weight loss",
        "severity": "fail",
        "patterns": [
          "\\bburn(s|ing|ed)?[ -]?(fat|calories)",
          "\\bfat[ -]?burn\\w*",
          "\\bcalorie(s)?\\b",
          "\\bweight[ -]?loss",
          "\\blos(e|es|ing)[ -]?weight\\b",
          "\\bmelt(s|ing|ed)?\\s+(away\\s+)?(the\\s+|your\\s+)?(belly\\s+)?fat\\b",
          "\\bweight[ -]?loss\\b",
          "\\blose\\s+weight\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "heals",
        "label": "heals (a body, injury or condition)",
        "severity": "fail",
        "patterns": [
          "\\bheal(s|ed)\\b",
          "\\bheal\\s+(your|the|my|our|their)\\b",
          "\\bheal(ing)?\\s+(\\w+\\s+){0,2}?(pain|aches?|injur\\w*|depression|anxiety|stress|insomnia|sleep|conditions?|symptoms?|diseases?|illness\\w*|inflamm\\w*|arthritis|ptsd|trauma|muscles?|soreness|joints?|headaches?|migraines?|fatigue|burnout|wounds?)\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "healing_ambiguous",
        "label": "\"healing\" can read as a health claim; keep it only in proper names (e.g. a business called Healing Arts)",
        "severity": "warn",
        "patterns": [
          "\\bhealing"
        ],
        "applies_to": "all"
      },
      {
        "id": "cures",
        "label": "cures",
        "severity": "fail",
        "patterns": [
          "\\bcur(es|ed|ing)\\b",
          "\\b(to|will|can|may|might|that|which|it|they|we|could|helps?|helps? to)\\s+cure\\b",
          "#cure\\w*"
        ],
        "applies_to": "all"
      },
      {
        "id": "cure_ambiguous",
        "label": "\"cure\" as a noun (\"the cure for Monday\") still suggests an outcome; reword",
        "severity": "warn",
        "patterns": [
          "\\bcure\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "treats",
        "label": "treats (a condition)",
        "severity": "fail",
        "patterns": [
          "\\btreat(s|ed|ing)?\\s+(\\w+\\s+){0,2}?(pain|aches?|injur\\w*|depression|anxiety|stress|insomnia|sleep|conditions?|symptoms?|diseases?|illness\\w*|inflamm\\w*|arthritis|ptsd|trauma|muscles?|soreness|joints?|headaches?|migraines?|fatigue|burnout|wounds?)\\b",
          "#treat(ment)?s?\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "treat_ambiguous",
        "label": "\"treat\"/\"treatment\" outside \"treat yourself\" or \"a treat\" can read as medical; check the context",
        "severity": "warn",
        "patterns": [
          "\\btreat(s|ed|ing|ment|ments)?\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "prevents",
        "label": "prevents (an illness or condition)",
        "severity": "fail",
        "patterns": [
          "\\bprevent(s|ed|ing|ion|ive|ative)?\\s+(\\w+\\s+){0,2}?(illness\\w*|diseases?|sickness|sick|flu|colds?|dementia|aging|heart|injur\\w*|inflamm\\w*|depression|anxiety|burnout|cancer|infections?)\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "prevent_ambiguous",
        "label": "\"prevent\" near health topics is a claim; fine for safety (\"prevent slipping\")",
        "severity": "warn",
        "patterns": [
          "\\bprevent(s|ed|ing|ion|ive|ative)?\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "mental_health_conditions",
        "label": "anxiety, depression, PTSD, trauma (as something a session fixes)",
        "severity": "fail",
        "patterns": [
          "\\banxiety",
          "\\bdepression",
          "\\bdepressive\\b",
          "\\bptsd",
          "\\btrauma(s|tic)?\\b(?![- ]informed)"
        ],
        "applies_to": "all"
      },
      {
        "id": "depressed_ambiguous",
        "label": "\"depressed\" reads as a mental-health condition",
        "severity": "warn",
        "patterns": [
          "\\bdepressed\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "arthritis",
        "label": "arthritis",
        "severity": "fail",
        "patterns": [
          "\\barthrit\\w*"
        ],
        "applies_to": "all"
      },
      {
        "id": "pain_relief",
        "label": "pain relief",
        "severity": "fail",
        "patterns": [
          "\\bpain[ -]?relie(f|ve|ves|ving)",
          "\\brelie(f|ve|ves|ving)( of| from)?[ -]?pain\\b",
          "\\b(ease|eases|easing|eased|soothe|soothes|soothing)\\s+(\\w+\\s+){0,2}?(joint\\s+)?pain\\b",
          "\\bjoint[ -]?pain\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "blood_pressure",
        "label": "blood pressure",
        "severity": "fail",
        "patterns": [
          "\\bblood[ -]?pressure"
        ],
        "applies_to": "all"
      },
      {
        "id": "heart_health",
        "label": "heart health",
        "severity": "fail",
        "patterns": [
          "\\bheart[ -]?health(y)?",
          "\\bheart[ -]?disease"
        ],
        "applies_to": "all"
      },
      {
        "id": "anti_aging",
        "label": "anti-aging, collagen, wrinkles",
        "severity": "fail",
        "patterns": [
          "\\banti[ -]?ag(e|ing)",
          "\\bcollagen",
          "\\bwrinkl\\w*"
        ],
        "applies_to": "all"
      },
      {
        "id": "illness",
        "label": "COVID, illness, disease, sickness or flu as something a session helps with",
        "severity": "fail",
        "patterns": [
          "\\bcovid",
          "\\billness(es)?\\b",
          "\\bdementia\\b",
          "\\bdisease(s)?\\b",
          "\\bsickness\\b",
          "\\b(get|gets|getting|got)\\s+sick\\b",
          "\\b(flu|cold|sick)[ -]?season\\b",
          "\\b(fight|fights|fighting|beat|beats|ward(s|ing)?\\s+off|keep(s|ing)?\\s+away|avoid|recover(s|y|ing)?\\s+from|get(ting)?\\s+over|less|fewer|no\\s+more|never)\\s+(\\w+\\s+){0,2}?(sick|sickness|ill|flu|colds?(?![\\s-]*(plunges?|water|tubs?|showers?|exposure|immersion|therapy|dips?|soaks?|baths?)\\b)|bugs?|viruse?s?|infections?)\\b",
          "#(flu|sick)\\w*"
        ],
        "applies_to": "all"
      },
      {
        "id": "sick_flu_ambiguous",
        "label": "\"sick\"/\"flu\" in a wellness post can imply a health claim; check the context",
        "severity": "warn",
        "patterns": [
          "\\bsick\\b",
          "\\bflu\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "proof_language",
        "label": "\"science-backed\", \"clinically proven\", \"studies show\"",
        "severity": "fail",
        "patterns": [
          "\\bscience[ -]?backed",
          "\\bclinically[ -]?proven",
          "\\bstudies[ -]?(show|prove)\\w*",
          "\\bresearch[ -]?(shows|proves)\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "fda",
        "label": "\"FDA-approved\" or the FDA logo (\"FDA-cleared\" only when naming the exact device and its exact cleared use)",
        "severity": "fail",
        "patterns": [
          "\\bfda[ -]?(approved|cleared)"
        ],
        "applies_to": "all"
      },
      {
        "id": "hormones",
        "label": "dopamine or hormone numbers",
        "severity": "fail",
        "patterns": [
          "\\bdopamine",
          "\\bnorepinephrine",
          "\\bnoradrenaline",
          "\\bcortisol",
          "\\bgrowth[ -]?hormone",
          "\\bhormone(s)?\\b(?![- ]free)",
          "\\bserotonin",
          "\\btestosterone"
        ],
        "applies_to": "all"
      },
      {
        "id": "breathwork_therapy",
        "label": "\"breathwork therapy\" from anyone who isn't licensed for it",
        "severity": "fail",
        "patterns": [
          "\\bbreathwork[ -]?therap(y|ies|ist|ists)\\b"
        ],
        "applies_to": "all"
      },
      {
        "id": "hedges",
        "label": "\"May help\", \"studies suggest\" and disclaimers don't fix a claim; reword the claim itself.",
        "severity": "warn",
        "patterns": [
          "\\bmay help\\b",
          "\\bstudies suggest\\b",
          "#?not ?medical ?advice"
        ],
        "applies_to": "all"
      },
      {
        "id": "outcome_verbs",
        "label": "Outcome promises (sleep, metabolism, soreness, recovery speed, stress levels) sell the outcome, not the experience; reword",
        "severity": "warn",
        "patterns": [
          "\\b(improve[sd]?|improving|better|deeper)\\s+(your\\s+)?sleep\\b",
          "\\bboost(s|ed|ing)?\\s+(your\\s+)?(metabolism|energy|mood|circulation|focus|recovery|performance)\\b",
          "\\b(reduce[sd]?|reducing|less|lower(s|ed|ing)?|ease[sd]?|easing)\\s+(your\\s+)?(muscle\\s+)?soreness\\b",
          "\\brecover(s|ing)?\\s+faster\\b",
          "\\bfaster\\s+recovery\\b",
          "\\bspeed(s|ing)?\\s+(up\\s+)?(your\\s+)?recovery\\b",
          "\\b(lower(s|ed|ing)?|reduce[sd]?|reducing|cut(s|ting)?)\\s+(your\\s+)?stress(\\s+levels?)?\\b",
          "\\bimprove[sd]?\\s+(your\\s+)?(circulation|recovery|focus|mood|performance|metabolism)\\b",
          "\\b(soothe|soothes|soothing|ease|eases|easing)\\s+(your\\s+)?(sore|tired|achy)\\s+muscles\\b",
          "\\bgood\\s+for\\s+(your\\s+)?(joints|heart|muscles|immune|skin|brain)\\b",
          "\\bendorphins?\\b"
        ],
        "applies_to": "all"
      }
    ],
    "allow_patterns": [
      "\\btreat(ing)?\\s+(yourself|yourselves|myself|ourselves|themselves)\\b",
      "\\ba\\s+(\\w+\\s+)?treat\\b(?!\\s+(for|of)\\b)"
    ],
    "allow_exact": [
      "Talk to your doctor first if you have a heart, blood pressure or breathing condition."
    ],
    "modalities": {
      "cold_plunge": {
        "say": [
          "Three minutes of cold. Walk out wide awake.",
          "A challenge that leaves many people feeling energized.",
          "Pairs well with the sauna for contrast."
        ],
        "never_say": [
          "Reduces inflammation (a 2025 meta-analysis found it rises right after a plunge)",
          "Boosts immunity",
          "Burns fat",
          "Heals injuries",
          "Treats depression"
        ]
      },
      "sauna": {
        "say": [
          "Deep, quiet heat to unwind.",
          "A centuries-old Finnish ritual.",
          "Relax, breathe, disconnect."
        ],
        "never_say": [
          "Detox or sweat out toxins",
          "Burns calories",
          "Lowers blood pressure",
          "Prevents heart disease or dementia"
        ]
      },
      "red_light": {
        "say": [
          "Accurate device facts (\"our panels use 660 nm and 850 nm light\"), only if true",
          "A warm, calming session"
        ],
        "never_say": [
          "Anti-aging, wrinkles, collagen",
          "Heals or reduces inflammation",
          "\"FDA-approved\"",
          "\"FDA-cleared\" unless it names the exact device and its exact cleared use"
        ],
        "device_facts": {
          "value": null,
          "status": "needs_katie",
          "source": "spec p.57 Q46",
          "note": "Panel make and model, wavelengths, and any FDA clearance (for what exactly)."
        }
      },
      "breathwork": {
        "say": [
          "Guided breathing to help you slow down.",
          "Feel more centered.",
          "Learn techniques people use to relax."
        ],
        "never_say": [
          "Cures anxiety",
          "Treats depression",
          "Heals trauma",
          "Boosts immunity",
          "\"Breathwork therapy\" from anyone who isn't licensed for it"
        ]
      }
    },
    "rules": [
      {
        "id": "visuals",
        "text": "Visuals count. No limping-in, jogging-out stories, no before/after of bodies, skin or bloodwork."
      },
      {
        "id": "testimonials",
        "text": "Testimonials are NUMA's claims. Feature experience (\"my favorite hour of the week\"), never outcomes (\"cured my back pain\"). Never repost or pin a member's health claim."
      },
      {
        "id": "education",
        "text": "Education stays education. Ask the DPT reels can explain what research does and doesn't show, but carry no booking pitch in the same reel, and never turn Katie's credential into a promise of results."
      },
      {
        "id": "titles",
        "text": "Titles matter. Breathwork staff are \"guides\" or \"facilitators\"; only licensed counselors talk about mental health, and only within their scope."
      },
      {
        "id": "safety",
        "text": "Safety is good content. Add the safety line on cold and heat reels; never show breath-holding in or near water."
      },
      {
        "id": "disclosure",
        "text": "Paid or comped creators disclose it in the video and the first line (\"#ad\" or \"I get free sessions\"). Reviews are never bought or conditioned on being positive."
      },
      {
        "id": "dosing",
        "text": "The website's dosing line (\"57 minutes of sauna and 11 of cold a week\") is a health-dosing claim; the Director doesn't use it until counsel clears it."
      },
      {
        "id": "ai_disclosure",
        "text": "Any reel with AI-animated people or AI-generated scenes gets Instagram's AI label."
      }
    ],
    "safety_line": {
      "text": "Talk to your doctor first if you have a heart, blood pressure or breathing condition.",
      "applies_to": [
        "cold_plunge",
        "sauna"
      ],
      "also": "Never show breath-holding in or near water.",
      "source": "spec p.22"
    },
    "dosing_line": {
      "text": "57 minutes of sauna and 11 of cold a week",
